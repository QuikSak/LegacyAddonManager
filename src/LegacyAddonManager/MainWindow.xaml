<Window x:Class="LegacyAddonManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Legacy Addon Manager" Width="1340" Height="940" MinWidth="1180" MinHeight="820" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="AddonMenuItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="#EFF3F9"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#303B4D"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AddonMenuSeparatorStyle" TargetType="Separator">
      <Setter Property="Margin" Value="8,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource BorderBrush}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AddonContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="MinWidth" Value="240"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource AddonMenuItemStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="8">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="30,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="50" Height="50" CornerRadius="12" Background="#342D22" BorderBrush="#705936" BorderThickness="1" Margin="0,0,16,0">
        <TextBlock Text="L" FontFamily="Georgia" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1"><TextBlock Text="Legacy Addon Manager" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="WORLD OF WARCRAFT  ·  3.3.5a" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
      <Button Grid.Column="2" Content="Settings" Command="{Binding SettingsCommand}" VerticalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="WoW installation" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding WoWPath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding WoWPath}" AutomationProperties.Name="WoW installation path"/>
          <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="10,0,0,0"/>
          <Button Grid.Column="2" Content="Open AddOns Folder" Command="{Binding OpenFolderCommand}" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="Addons are installed in Interface\AddOns. Close WoW before updating." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SyncDescription}" ToolTip="{Binding SyncDescription}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="rclone Setup…" Command="{Binding RcloneSetupCommand}" Margin="0,0,8,0" ToolTip="Connect a storage remote using bundled rclone; no background sync client needed"/>
              <Button Content="Publish to Profile" Command="{Binding PublishProfileCommand}" Margin="0,0,8,0" ToolTip="Publisher only: share exact installed GitHub versions"/>
              <Button Content="Sync from Profile" Command="{Binding SyncProfileCommand}" ToolTip="Preview installs, replacements and optional removals"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,14">
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Your addons" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Refresh Addons" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
        <Button Content="+  Add GitHub Repository" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <Button Content="Edit Source" Command="{Binding EditSourceCommand}" Margin="0,0,8,0" ToolTip="Adopt the selected folder without changing its files"/>
        <Button Content="Stop Managing" Command="{Binding StopManagingCommand}" Margin="0,0,8,0" ToolTip="Remove the selected folder's source association; keep every installed file"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Check Selected" Command="{Binding CheckSelectedCommand}" Margin="0,0,8,0"/>
        <Button Content="Check All" Command="{Binding CheckCommand}"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Grid>
        <DataGrid ItemsSource="{Binding Addons}" SelectedItem="{Binding Selected}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Managed addons">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="AddonRow_PreviewMouseRightButtonDown"/>
              <EventSetter Event="ContextMenuOpening" Handler="AddonRow_ContextMenuOpening"/>
              <Setter Property="ContextMenu"><Setter.Value>
                <ContextMenu Style="{StaticResource AddonContextMenuStyle}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Edit Source" Command="{Binding EditSourceCommand}"/>
                  <MenuItem Header="Check Selected" Command="{Binding CheckSelectedCommand}"/>
                  <MenuItem Header="Update Selected" Command="{Binding UpdateSelectedCommand}"/>
                  <MenuItem Header="Install" Command="{Binding InstallCommand}"/>
                  <Separator Style="{StaticResource AddonMenuSeparatorStyle}"/>
                  <MenuItem Header="Stop Managing" Command="{Binding StopManagingCommand}" ToolTip="Remove the source association; keep all installed files"/>
                  <MenuItem Header="Remove Addon…" Command="{Binding RemoveCommand}" Foreground="#FFABAB" ToolTip="Uninstall the selected source group's folders after confirmation"/>
                  <Separator Style="{StaticResource AddonMenuSeparatorStyle}"/>
                  <MenuItem Header="Check All" Command="{Binding CheckCommand}"/>
                  <MenuItem Header="Update All" Command="{Binding UpdateAllCommand}"/>
                  <MenuItem Header="Refresh Addons" Command="{Binding RefreshCommand}"/>
                  <MenuItem Header="Add GitHub Repository" Command="{Binding AddCommand}"/>
                  <MenuItem Header="Open AddOns Folder" Command="{Binding OpenFolderCommand}"/>
                </ContextMenu>
              </Setter.Value></Setter>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Addon" Binding="{Binding Name}" Width="1.2*" MinWidth="160"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Name}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="150"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Folder}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Header="Installed Version" Binding="{Binding InstalledVersion}" Width="135"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding VersionTooltip}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Header="Latest Version" Binding="{Binding LatestVersion}" Width="125"/>
            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" MinWidth="235"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Source}"/><Setter Property="Foreground" Value="#AAB9D0"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTemplateColumn Header="Status" Width="215"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Addons.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="Discover your installed addons" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Choose your WoW folder to scan AddOns, or add a repository to install." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="5" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,18,0" VerticalAlignment="Center"><TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" MaxHeight="68"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="Install" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
        <Button Content="Update Selected" Command="{Binding UpdateSelectedCommand}" Margin="0,0,8,0" ToolTip="Update every folder associated with the selected source"/>
        <Button Content="Update All" Command="{Binding UpdateAllCommand}" Margin="0,0,8,0" ToolTip="Update source groups with a known different version; unknown-only groups are preserved"/>
        <Button Content="Remove Addon…" Command="{Binding RemoveCommand}" Foreground="#FFABAB" ToolTip="Uninstall the selected source group's folders after confirmation"/>
      </StackPanel>
    </Grid>
    <Expander Grid.Row="6" Header="Addon details" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0">
      <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Selected.MetadataSummary}" Style="{StaticResource MutedText}" FontSize="12" Margin="4,10,0,0"/></ScrollViewer>
    </Expander>
    <Border Grid.Row="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="12"/><ProgressBar Height="3" Margin="0,9,18,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#252E3E" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></StackPanel>
        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="12,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
