<Window x:Class="LegacyAddonManager.Views.RcloneSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="rclone Sync Setup" Width="760" Height="820" MinWidth="690" MinHeight="650" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#EFF3F9"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#303B4D"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#675433"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EFF3F9"/><Setter Property="MinHeight" Value="40"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#111722" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"><TextBlock Text="▼" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="10"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="12,6,30,6" VerticalAlignment="Center"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4">
              <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Sync with rclone" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="The bundled rclone transfers your addon profile on demand. Configure the same storage location on both computers; credentials stay local." Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="1. Connect your storage account" FontWeight="SemiBold"/>
        <TextBlock Text="Use Configure Remote for rclone's account setup. It opens a console wizard and may open your browser for sign-in. Close the wizard when finished, then refresh the remotes." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,12"/>
        <TextBlock Text="Local rclone config file" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="ConfigBox" IsReadOnly="True" TextChanged="ConfigurationChanged" AutomationProperties.Name="rclone config path"/>
          <Button Grid.Column="1" Content="Existing Config…" Click="BrowseConfig_Click" Margin="8,0,0,0"/>
        </Grid>
        <Expander x:Name="PasswordOptions" Header="Encrypted config password (optional)" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Leave blank to keep the saved password." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,6"/>
            <PasswordBox x:Name="PasswordInput" PasswordChanged="ConfigurationChanged" AutomationProperties.Name="Optional rclone config password"/>
            <CheckBox x:Name="ClearPasswordBox" Content="Clear the saved config password" Checked="ConfigurationChanged" Unchecked="ConfigurationChanged" Margin="0,8,0,0"/>
          </StackPanel>
        </Expander>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,22">
          <Button x:Name="ConfigureButton" Content="Configure Remote…" Click="Configure_Click" Margin="0,0,8,0"/>
          <Button x:Name="RefreshButton" Content="Refresh Remotes" Click="Refresh_Click"/>
        </StackPanel>
        <TextBlock Text="2. Choose the shared profile" FontWeight="SemiBold"/>
        <TextBlock Text="Configured remote" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,6"/>
        <ComboBox x:Name="RemoteBox" SelectionChanged="RemoteChanged" AutomationProperties.Name="Configured rclone remote"/>
        <TextBlock Text="Remote profile path (example: cloud:WoW/legacy-addons.json)" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,6"/>
        <TextBox x:Name="RemotePathBox" TextChanged="ConfigurationChanged" AutomationProperties.Name="rclone remote profile"/>
        <TextBlock Text="An existing profile connects as a follower unless you are its publisher. A new filename makes this computer the publisher. No remote files are changed during setup." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,12"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,12" MaxHeight="80" AutomationProperties.Name="rclone connection status"/>
      <Grid>
        <Button x:Name="TestButton" Content="Test Connection" Click="Test_Click" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="SaveButton" Content="Use rclone" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
