<Window x:Class="LegacyAddonManager.Views.ProfilePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Shared addon profile" Width="780" Height="650" MinWidth="640" MinHeight="470" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="SummaryText" Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <ItemsControl x:Name="ChangesList" AutomationProperties.Name="Profile preview changes">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,14" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Action}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <CheckBox x:Name="RemoveExtrasBox" Grid.Row="3" Content="Also uninstall managed sources absent from this profile" Visibility="Collapsed" Margin="0,18,0,0" Checked="RemovalChanged" Unchecked="RemovalChanged"/>
    <TextBlock x:Name="SafetyText" Grid.Row="4" Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
      <Button x:Name="ApplyButton" Content="Sync Now" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
    </StackPanel>
  </Grid>
</Window>
