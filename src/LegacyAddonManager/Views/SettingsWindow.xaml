<Window x:Class="LegacyAddonManager.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Settings" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26">
    <TextBlock Text="GitHub access" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Public repositories work without an account. An optional personal access token increases GitHub API rate limits." Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
    <TextBlock x:Name="TokenState" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
    <TextBlock Text="Personal access token (optional)" Margin="0,0,0,8"/>
    <PasswordBox x:Name="TokenBox" AutomationProperties.Name="Optional GitHub personal access token"/>
    <TextBlock Text="Leave blank to keep the current token. Tokens are encrypted for your Windows user and sent only to api.github.com." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,16"/>
    <CheckBox x:Name="ClearBox" Content="Clear the saved token"/>
    <TextBlock Text="Settings location: %LocalAppData%\WoWAddonManager\settings.json" Style="{StaticResource MutedText}" FontSize="12" Margin="0,22,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/><Button Content="Save Settings" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </StackPanel>
</Window>
