<Window x:Class="LegacyAddonManager.Views.RepositoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Add GitHub Repository" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26">
    <TextBlock x:Name="Heading" Text="Add a repository" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock x:Name="Description" Text="Use a public GitHub repository containing addons for WoW 3.3.5a." Style="{StaticResource MutedText}" Margin="0,10,0,20"/>
    <TextBlock Text="Repository URL" Margin="0,0,0,8"/>
    <TextBox x:Name="UrlBox" AutomationProperties.Name="GitHub repository URL"/>
    <TextBlock Text="https://github.com/ProfetGit/RefactorGear" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
    <TextBlock x:Name="ValidationText" Foreground="#FF9696" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="Add Repository" IsDefault="True" Click="Add_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </StackPanel>
</Window>
